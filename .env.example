# Copy to .env and fill in values. Never commit .env.

APP_ENV=local

# --- Database (local Postgres via docker-compose) ---
DATABASE_URL=postgresql+psycopg://contract:contract@localhost:5432/contract_review
# Used by pytest; its schema is dropped and rebuilt on every test run.
TEST_DATABASE_URL=postgresql+psycopg://contract:contract@localhost:5432/contract_review_test

# --- LLM provider: gemini | groq | ollama ---
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
# Retries apply to 429, 5xx, and timeouts, using exponential backoff with full jitter.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=1.0
LLM_RETRY_MAX_SECONDS=30.0

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Free key: https://console.groq.com/keys
# Structured output (response_schema) requires a Groq model that supports json_schema.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local, no key: https://ollama.com/download, then `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Agent (per-contract limits keep analysis within free-tier quotas) ---
# PLAYBOOK_PATH=        # defaults to backend/playbooks/default.yaml
AGENT_BATCH_SIZE=5
AGENT_MAX_ITERATIONS=25
AGENT_TOKEN_BUDGET=150000
AGENT_MAX_CONTRACT_CHARS=60000

# --- Storage ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
# S3_BUCKET=            # deploy only

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
